    <!-- 1. First obstacle after the initial clear area. -->
    <model name="obstacle_01_first_turn">
      <static>true</static><pose>2.35 2 0.35 0 0 0.20</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.70</size></box></geometry><material><ambient>0.30 0.25 0.22 1</ambient><diffuse>0.39 0.32 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 2. Obstacle after the following 90-degree turn. -->
    <model name="obstacle_02_after_corner">
      <static>true</static><pose>5 3.35 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry><material><ambient>0.39 0.26 0.18 1</ambient><diffuse>0.47 0.31 0.21 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 3-5. Triple chicane on the long right section. -->
    <model name="obstacle_03_chicane_inner">
      <static>true</static><pose>6.35 5.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry><material><ambient>0.36 0.24 0.18 1</ambient><diffuse>0.44 0.29 0.21 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_04_chicane_outer">
      <static>true</static><pose>7.65 7 0.35 0 0 -0.20</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.70</size></box></geometry><material><ambient>0.28 0.24 0.22 1</ambient><diffuse>0.37 0.31 0.28 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_05_chicane_inner">
      <static>true</static><pose>6.35 8.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry><material><ambient>0.38 0.25 0.18 1</ambient><diffuse>0.46 0.30 0.21 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 6. Larger rectangular obstacle with one clearly safer side. -->
    <model name="obstacle_06_large_box">
      <static>true</static><pose>5 10.62 0.35 0 0 0.20</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.70 0.40 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.70 0.40 0.70</size></box></geometry><material><ambient>0.27 0.23 0.21 1</ambient><diffuse>0.36 0.30 0.27 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 7. Obstacle immediately after entering the upper vertical section. -->
    <model name="obstacle_07_upper_turn">
      <static>true</static><pose>2.35 12 0.35 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.70</size></box></geometry></collision>

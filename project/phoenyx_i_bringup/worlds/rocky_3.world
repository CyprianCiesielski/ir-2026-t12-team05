<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="rocky_3">
    <!-- Level 2 advanced training world: stepped corridor with ten obstacles. -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Walls: the Level 1 layout has been enlarged from 1.5 m to 2 m. -->
    <model name="stepped_corridor_walls">
      <static>true</static>

      <!-- Inner boundary. -->
      <link name="inner_01">
        <pose>0 1 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4 0.1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4 0.1 1</size></box></geometry><material><ambient>0.82 0.76 0.68 1</ambient><diffuse>0.82 0.76 0.68 1</diffuse></material></visual>

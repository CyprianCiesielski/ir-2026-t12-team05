    <!-- 8-9. Staggered S-shaped passage across the top section. -->
    <model name="obstacle_08_s_outer">
      <static>true</static><pose>1 14.65 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.70</length></cylinder></geometry></collision>
